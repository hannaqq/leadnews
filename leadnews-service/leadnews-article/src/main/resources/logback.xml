<?xml version="1.0" encoding="UTF-8"?>

<configuration>



    <property value="d:/Qiao/logs" name="LOG_HOME"/>

    <!-- Console output settings. -->



    -<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">


    -<encoder>

    <!-- Output format: date, thread name, five-character log level, message, and line break. -->


    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>

    <charset>utf8</charset>

</encoder>

</appender>

    <!-- Generate one log file per day. -->



    -<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">


    -<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

    <!-- Log file name pattern. -->


    <fileNamePattern>${LOG_HOME}/leadnews.%d{yyyy-MM-dd}.log</fileNamePattern>

</rollingPolicy>


    -<encoder>

    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>

</encoder>

</appender>

    <!-- Asynchronous output. -->



    -<appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">

    <!-- Preserve all log events instead of discarding low-level events when the queue is 80% full. -->


    <discardingThreshold>0</discardingThreshold>

    <!-- Set the queue capacity; this value affects performance and defaults to 256. -->


    <queueSize>512</queueSize>

    <!-- Attach the target appender; an AsyncAppender supports only one appender reference. -->


    <appender-ref ref="FILE"/>

</appender>


    -<logger name="org.apache.ibatis.cache.decorators.LoggingCache" additivity="false" level="DEBUG">

    <appender-ref ref="CONSOLE"/>

</logger>

    <logger name="org.springframework.boot" level="debug"/>


    -<root level="info">

    <!--<appender-ref ref="ASYNC"/>-->


    <appender-ref ref="FILE"/>

    <appender-ref ref="CONSOLE"/>

</root>

</configuration>
